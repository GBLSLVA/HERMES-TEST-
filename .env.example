APP_ENV=development
API_HOST=0.0.0.0
API_PORT=8000
DATABASE_URL=postgresql+psycopg://hermes:hermes@localhost:5432/hermes
REDIS_URL=redis://localhost:6379/0

# Meta / WhatsApp
WHATSAPP_VERIFY_TOKEN=change-me
WHATSAPP_APP_SECRET=change-me
WHATSAPP_ACCESS_TOKEN=change-me

# Instagram
INSTAGRAM_APP_SECRET=change-me
INSTAGRAM_ACCESS_TOKEN=change-me

# Hermes Agent API Server
# Ative somente depois de iniciar o gateway do Hermes com API Server habilitado.
HERMES_ENABLED=false
HERMES_BASE_URL=http://localhost:8642
HERMES_API_KEY=change-me-local-dev
HERMES_MODEL=hermes-agent
HERMES_TIMEOUT_SECONDS=30
