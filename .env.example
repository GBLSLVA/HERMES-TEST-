APP_ENV=development
API_HOST=0.0.0.0
API_PORT=8000
DATABASE_URL=postgresql+psycopg://hermes:hermes@localhost:5432/hermes
REDIS_URL=redis://localhost:6379/0
CORS_ORIGINS=http://localhost:5173

# Front-end (Vite)
VITE_API_URL=http://localhost:8000
VITE_TENANT_ID=

# Meta / WhatsApp
WHATSAPP_VERIFY_TOKEN=change-me
WHATSAPP_APP_SECRET=change-me
WHATSAPP_ACCESS_TOKEN=change-me

# Instagram
INSTAGRAM_APP_SECRET=change-me
INSTAGRAM_ACCESS_TOKEN=change-me

# ZEUS AGENT — provider técnico atual: Hermes Agent API Server
# As variáveis HERMES_* são mantidas por compatibilidade com o provider atual.
# Ative somente depois de iniciar o gateway do provider com API Server habilitado.
HERMES_ENABLED=false
HERMES_BASE_URL=http://localhost:8642
HERMES_API_KEY=change-me-local-dev
HERMES_MODEL=hermes-agent
HERMES_TIMEOUT_SECONDS=30
